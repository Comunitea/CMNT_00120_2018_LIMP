<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="service_picking_signature_wzd_form" model="ir.ui.view">
        <field name="name">service.picking.signature.wzd.form</field>
        <field name="model">service.picking.signature.wzd</field>
        <field name="arch" type="xml">
            <form string="Picking signature wizard">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <h2>
                        <field name="partner_id" />
                    </h2>
                    <group>
                        <field name="signature_date"/>
                        <field name="signature_name"/>
                        <field name="signature_job"/>
                        <field name="signature_vat"/>
                        <field name="picking_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="signature_image" widget="signature" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_sign" string="Sign" class="btn-primary" type="object"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
