<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="anomalies_tree" model="ir.ui.view">
        <field name="name">extinguisher.bies.anomalies.tree</field>
        <field name="model">extinguisher.bies.anomalies</field>
        <field name="arch" type="xml">
            <tree default_order="date">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="date"/>
            </tree>
        </field>
    </record>
    <record id="anomalies_search" model="ir.ui.view">
        <field name="name">extinguisher.bies.anomalies.search</field>
        <field name="model">extinguisher.bies.anomalies</field>
        <field name="arch" type="xml">
            <search string="Search Anomalies">
                <field name="name" string="Name"/>
                <field name="picking_id" string="Picking"/>
                <field name="date" string="Date"/>
                <filter name="date" string="Date" date="date"/>
            </search>
        </field>
    </record>
</odoo>
