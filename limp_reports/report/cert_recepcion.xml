<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="cert_recepcion">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="plant_partner" t-value="o.line_ids[:1].service_picking_id.stock_picking_id[:1].picking_type_id.warehouse_id.partner_id or res_company.partner_id"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 10pt; font-family: 'Arial MT', Arial, sans-serif;">
                        <style>
                            .cert_table, .cert_table > thead > tr > td, .cert_table > tbody > tr > td {
                                border: 1px solid #000;
                                border-collapse: collapse;
                                padding: 3px;
                                font-family: 'Arial MT', Arial, sans-serif;
                            }
                        </style>
                        <div class="oe_structure"/>
                        <div id="fecha" style="text-align: right; margin-bottom: 20px;">
                            <p>Lugo, <span t-esc="o._translate_date()"/></p>
                        </div>
                        <h4 style="text-align: center; font-size: 12pt; font-family: 'Arial MT', Arial, sans-serif; margin-bottom: 20px;">
                            CERTIFICADO DE RECEPCIÓN
                        </h4>
                        <div id="main" style="text-align: justify; margin-top: 20px;">
                            <p>
                                La empresa <span t-esc="res_company.name"/> con CIF <span t-esc="res_company.vat"/> y domicilio social en
                                <span t-esc="o._partner_address(res_company.partner_id)"/>, en conformidad con lo establecido en la
                                legislación vigente relativa a la gestión de residuos,
                            </p>
                            <p>CERTIFICA:</p>
                            <p>
                                Haber recibido en nuestra planta de gestión sita en
                                <span t-esc="o._partner_address(plant_partner)"/> los siguientes residuos
                                provenientes de su empresa desde el día
                                <span t-field="o.date_init" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                hasta el día
                                <span t-field="o.date_end" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>.
                            </p>
                        </div>
                        <div id="table" style="text-align: center;">
                            <table class="cert_table table mt8 table-sm" style="font-size: 9pt; font-weight: bold; width: 100%;">
                                <thead>
                                    <tr>
                                        <td>CLIENTE</td>
                                        <td colspan="2"><t t-esc="o.partner_id.name"/></td>
                                        <td colspan="2">OBRA</td>
                                        <td colspan="3"><t t-esc="o.building_site_id.name"/></td>
                                    </tr>
                                </thead>
                            </table>
                            <table class="cert_table table mt8 table-sm" style="font-size: 8pt; width: 100%;">
                                <thead>
                                    <tr>
                                        <td>Fecha</td>
                                        <td>Nº Documento Identificación</td>
                                        <td>Productor</td>
                                        <td>NIF</td>
                                        <td>LER</td>
                                        <td>Descripción Residuo</td>
                                        <td>Tipo de operación</td>
                                        <td>Nº Autorización</td>
                                        <td>Peso Kg</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.line_ids" t-as="line">
                                        <tr>
                                            <td><span t-field="line.date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></td>
                                            <td><span t-field="line.dcs_no"/></td>
                                            <td><span t-field="line.producer_id.commercial_partner_id.name"/></td>
                                            <td><span t-field="line.nif"/></td>
                                            <td><span t-field="line.ler"/></td>
                                            <td><span t-field="line.description"/></td>
                                            <td><span t-field="line.operation_type"/></td>
                                            <td><span t-field="line.authorization_no"/></td>
                                            <td><span t-field="line.weight"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <br/>
                        <div class="container" style="page-break-inside: avoid;">
                            <div id="end" class="row">
                                <div class="col-8">
                                    <p>
                                        Sin otro particular, reciban un cordial saludo
                                    </p>
                                </div>
                                <div class="col-2">
                                    <div>
                                        <img src="/limp_reports/static/src/img/sello_limp.png" style="width: 200px" alt="sello"/>
                                    </div>
                                    <br/>
                                    <div>
                                        <p>LIMPERGAL SL</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
