<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="cert_recepcion">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[0]"/>
            <t t-set="dated_docs" t-value="docs.filtered(lambda p: p.date_done or p.date)"/>
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 10pt; font-family: 'Arial MT', Arial, sans-serif;">
                    <style>
                        .cert_table, .cert_table > thead > tr > td, .cert_table > tbody > tr > td {
                            border: 1px solid #000;
                            border-collapse: collapse;
                            padding: 3px;
                            font-family: 'Arial MT', Arial, sans-serif;
                        }
                    </style>
                    <div class="oe_structure"/>
                    <div id="fecha" style="text-align: right; margin-bottom: 20px;">
                        <p>Lugo, <span t-esc="o._cert_recepcion_today()"/></p>
                    </div>
                    <h4 style="text-align: center; font-size: 12pt; font-family: 'Arial MT', Arial, sans-serif; margin-bottom: 20px;">
                        CERTIFICADO DE RECEPCIÓN
                    </h4>
                    <div id="main" style="text-align: justify; margin-top: 20px;">
                        <p>
                            La empresa <span t-esc="o.company_id.name"/> con CIF <span t-esc="o.company_id.vat"/> y domicilio social en
                            <span t-esc="o._cert_recepcion_partner_address(o.company_id.partner_id)"/>, en conformidad con lo establecido en la
                            legislación vigente relativa a la gestión de residuos,
                        </p>
                        <p>CERTIFICA:</p>
                        <p>
                            Haber recibido en nuestra planta de gestión sita en
                            <span t-esc="o._cert_recepcion_partner_address(o.picking_type_id.warehouse_id.partner_id)"/> los siguientes residuos
                            provenientes de su empresa desde el día
                            <span t-esc="dated_docs and min(dated_docs.mapped(lambda p: p.date_done or p.date)).strftime('%d/%m/%Y') or ''"/>
                            hasta el día
                            <span t-esc="dated_docs and max(dated_docs.mapped(lambda p: p.date_done or p.date)).strftime('%d/%m/%Y') or ''"/>.
                        </p>
                    </div>
                    <div id="table" style="text-align: center;">
                        <table class="cert_table table mt8 table-sm" style="font-size: 9pt; font-weight: bold; width: 100%;">
                            <thead>
                                <tr>
                                    <td>CLIENTE</td>
                                    <td colspan="2"><t t-esc="o.partner_id.name"/></td>
                                    <td colspan="2">OBRA</td>
                                    <td colspan="3"><t t-esc="o.stock_service_picking_id.building_site_id.name"/></td>
                                </tr>
                            </thead>
                        </table>
                        <table class="cert_table table mt8 table-sm" style="font-size: 8pt; width: 100%;">
                            <thead>
                                <tr>
                                    <td>Fecha</td>
                                    <td>Nº Documento Identificación</td>
                                    <td>Productor</td>
                                    <td>NIF</td>
                                    <td>LER</td>
                                    <td>Descripción Residuo</td>
                                    <td>Tipo de operación</td>
                                    <td>Nº Autorización</td>
                                    <td>Peso Kg</td>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="pick">
                                    <t t-foreach="pick.stock_service_picking_id.service_picking_valorization_ids" t-as="v">
                                        <tr>
                                            <td><span t-esc="(pick.date_done or pick.date).strftime('%d/%m/%Y') if (pick.date_done or pick.date) else ''"/></td>
                                            <td><span t-esc="pick.stock_service_picking_id.dcs_no"/></td>
                                            <td><span t-esc="pick.stock_service_picking_id.producer_promoter_id.commercial_partner_id.name"/></td>
                                            <td><span t-esc="pick.stock_service_picking_id.producer_promoter_id.commercial_partner_id.vat"/></td>
                                            <td><span t-esc="v.ler_code"/></td>
                                            <td><span t-esc="v.name"/></td>
                                            <td><span t-esc="v.operation_type"/></td>
                                            <td><span t-esc="pick._cert_recepcion_authorization_no(v.ler_code)"/></td>
                                            <td><span t-esc="'{:,.0f}'.format(v.net_weight * 1000).replace(',', '.')"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <br/>
                    <div class="container" style="page-break-inside: avoid;">
                        <div id="end" class="row">
                            <div class="col-8">
                                <p>
                                    Sin otro particular, reciban un cordial saludo
                                </p>
                            </div>
                            <div class="col-2">
                                <div>
                                    <img src="/limp_reports/static/src/img/sello_limp.png" style="width: 200px" alt="sello"/>
                                </div>
                                <br/>
                                <div>
                                    <p>LIMPERGAL SL</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
